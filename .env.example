# ==========================================
# Omni-Channel Voice Agent | Configuration
# ==========================================

# Active Model Providers: "local" (Free CUDA + Clef) or "sarvam" (Sarvam Indic) or "elevenlabs"
STT_PROVIDER=local
SYSTEM_ONE_PROVIDER=clef
LLM_PROVIDER=local
TTS_PROVIDER=local

# Optional Cloud API Keys (Can also be set in Frontend BYOK Dialog)
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
JEV_API_KEY=

# Sarvam AI Indic Defaults
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANG=en-IN
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANG=en-IN

# ElevenLabs Voice Defaults
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Local CUDA Endpoints (Whisper.cpp / llama.cpp / Clef / Kokoro)
LLAMA_SERVER_URL=http://127.0.0.1:8080
WHISPER_SERVER_URL=http://127.0.0.1:8082
CLEF_SERVER_URL=http://127.0.0.1:8085
TTS_SERVER_URL=http://127.0.0.1:8083

# Carrier Server Port
PORT=8090
